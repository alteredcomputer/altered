{
    "name": "altered",
    "private": true,
    "type": "module",

    "scripts": {
        "check:types": "turbo check:types",
        "check:style": "ultracite check",
        "check": "turbo check:types //#check:style",

        "fix:style": "ultracite fix",
        "fix:style:force": "ultracite fix --unsafe",
        "fix": "pnpm fix:style"
    },

    "devDependencies": {
        "@altered/tooling": "workspace:*",
        "@biomejs/biome": "2.6.8",
        "@types/node": "catalog:",
        "turbo": "2.11.11",
        "typescript": "catalog:",
        "ultracite": "8.2.1"
    },

    "packageManager": "pnpm@12.15.0",

    "devEngines": {
        "runtime": {
            "name": "node",
            "version": "26.13.1",
            "onFail": "download"
        }
    }
}
