#!/bin/sh

# Git gives hooks no terminal, so prompts would read from the commit's `stdin` and could be answered by piping input. Attach the real terminal instead, probing in a subshell first so a shell with no usable terminal falls through to the CLI's own refusal rather than a cryptic redirect error.

if (exec < /dev/tty) 2>/dev/null; then exec < /dev/tty; fi

pnpm exec altered-certify-commit
