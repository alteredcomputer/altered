#!/bin/sh

# Git runs this hook for merges too, where certification is the merge gate's job. Leaving early also keeps a certification that was answered and then abandoned at the editor from ever being stamped onto a different commit.

if [ -e "$(git rev-parse --git-path MERGE_HEAD)" ]; then exit 0; fi

pnpm exec tsx packages/tooling/bin/record-certification.ts "$1"
